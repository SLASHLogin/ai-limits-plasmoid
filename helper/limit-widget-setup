#!/usr/bin/env python3
"""Configure provider bridges without storing credentials in the widget."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shlex
import shutil
import sys


BRIDGE = "limit-widget-claude-statusline"


def write_json(path: Path, value: object) -> None:
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(path)


def configure_claude() -> int:
    settings_path = Path.home() / ".claude" / "settings.json"
    if settings_path.exists():
        try:
            settings = json.loads(settings_path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as error:
            print(f"Could not read {settings_path}: {error}", file=sys.stderr)
            return 1
    else:
        settings = {}

    status = settings.get("statusLine")
    if status is not None and not isinstance(status, dict):
        print(f"{settings_path}: statusLine is not an object", file=sys.stderr)
        return 1
    status = dict(status or {})
    if status.get("type", "command") != "command":
        print(f"{settings_path}: existing statusLine is not a command", file=sys.stderr)
        return 1

    command = status.get("command")
    if isinstance(command, str) and command.startswith(BRIDGE):
        print("Claude Code bridge is already configured.")
        return 0

    backup = settings_path.with_name(settings_path.name + ".limit-widget-backup")
    if settings_path.exists() and not backup.exists():
        shutil.copy2(settings_path, backup)
        backup.chmod(0o600)
        print(f"Backed up existing settings to {backup}")

    if isinstance(command, str) and command.strip():
        wrapped = shlex.join([BRIDGE, "--delegate", "bash", "-lc", command])
    else:
        wrapped = BRIDGE
    status["type"] = "command"
    status["command"] = wrapped
    settings["statusLine"] = status

    settings_path.parent.mkdir(parents=True, exist_ok=True)
    write_json(settings_path, settings)
    print(f"Configured Claude Code status line in {settings_path}")
    print("The widget will receive 5h and 7d values after Claude produces its next response.")
    return 0


def restore_claude() -> int:
    settings_path = Path.home() / ".claude" / "settings.json"
    backup = settings_path.with_name(settings_path.name + ".limit-widget-backup")
    if not backup.exists():
        print(f"No backup found at {backup}", file=sys.stderr)
        return 1
    shutil.copy2(backup, settings_path)
    settings_path.chmod(0o600)
    print(f"Restored {settings_path}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Configure AI Limits provider bridges")
    parser.add_argument("provider", choices=("claude",), help="provider to configure")
    parser.add_argument("--restore", action="store_true", help="restore the pre-setup Claude settings")
    args = parser.parse_args()
    return restore_claude() if args.restore else configure_claude()


if __name__ == "__main__":
    raise SystemExit(main())
