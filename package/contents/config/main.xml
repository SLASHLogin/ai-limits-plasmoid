<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name="" />
    <group name="General">
        <entry name="refreshInterval" type="Int">
            <default>300</default>
        </entry>
        <entry name="showUnsupported" type="Bool">
            <default>true</default>
        </entry>
        <!-- Hide in the panel providers that have nothing to show: no live
             sign-in, a plan without any allowance, or an allowance nothing was
             consumed from yet. The popup keeps listing every row; transient
             error rows stay visible everywhere. -->
        <entry name="hideEmptyProviders" type="Bool">
            <default>false</default>
        </entry>
        <!-- Show the closest upcoming reset when a rolling session/weekly
             window is exhausted. Monthly allowances are excluded. -->
        <entry name="showExhaustedReset" type="Bool">
            <default>true</default>
        </entry>
        <!-- What the popup's reset hint contains: the short duration until
             the reset ("30min"), the absolute date ("14 Oct 12:25"), or
             both. The taskbar always shows the short duration alone. -->
        <entry name="resetTextFormat" type="String">
            <default>long</default>
        </entry>
        <!-- Comma-separated provider ids to hide. Hiding rather than choosing
             what to show means a newly supported provider appears by default
             instead of silently missing from an existing configuration. -->
        <entry name="hiddenProviders" type="String">
            <default></default>
        </entry>
        <!-- Absolute path to the CodexBar CLI, for installs that are not on
             PATH. Empty means "look for codexbar on PATH". -->
        <entry name="codexbarPath" type="String">
            <default></default>
        </entry>
        <!-- Written by the widget after each refresh as "id=Name,id=Name", so
             the settings page can list providers it has no other way to know
             about — the ones discovered through CodexBar. -->
        <entry name="lastProviderList" type="String">
            <default></default>
        </entry>
    </group>
</kcfg>
