def config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def config_dir() -> Path:
    return config_home() / "limit-widget"


def load_json(path: Path) -> Any:
    try:
        with path.open("r", encoding="utf-8") as stream:
            return json.load(stream)
    except (OSError, ValueError, TypeError):
        return None


def write_json_atomic(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    # These files hold OAuth tokens, so the descriptor is opened 0600 rather
    # than written under the umask and narrowed afterwards: a chmod after the
    # write leaves the token world-readable for the length of the write.
    # O_CREAT leaves an existing file's mode alone, and a .tmp left behind by an
    # older build would still carry 0644, so drop it before creating the new one.
    temporary.unlink(missing_ok=True)
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, separators=(",", ":"))
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise
    temporary.replace(path)


def provider_records(payload: Any) -> dict[str, dict[str, Any]]:
    """Accept either {"providers": [...]} or a provider-id keyed object."""
    if not isinstance(payload, dict):
        return {}
    payload = payload.get("providers", payload)
    if isinstance(payload, list):
        return {
            item.get("id"): item
            for item in payload
            if isinstance(item, dict) and isinstance(item.get("id"), str)
        }
    if isinstance(payload, dict):
        return {
            key: value
            for key, value in payload.items()
            if isinstance(key, str) and isinstance(value, dict)
        }
    return {}


def finite_number(value: Any) -> int | float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if value < 0:
        return None
    return value


def used_percentage(raw: dict[str, Any]) -> float | None:
    for key in ("usedPercentage", "used_percentage", "used_percent"):
        value = finite_number(raw.get(key))
        if value is not None and value <= 100:
            return float(value)
    return None


def iso_from_epoch(value: Any) -> str | None:
    number = finite_number(value)
    if number is None:
        return None
    try:
        return datetime.fromtimestamp(float(number), timezone.utc).isoformat()
    except (OverflowError, OSError, ValueError):
        return None


def normalize_window(raw: Any, default_id: str, default_label: str) -> dict[str, Any] | None:
    if not isinstance(raw, dict):
        return None

    remaining = finite_number(raw.get("remaining"))
    limit = finite_number(raw.get("limit"))
    used = finite_number(raw.get("used"))
    percentage = used_percentage(raw)

    # Percent windows are the native representation used by Codex and Claude.
    # A 100-point window is explicit and does not pretend to be a message count.
    if remaining is None and percentage is not None:
        limit = 100
        remaining = max(0, 100 - percentage)
        used = percentage
    if remaining is None and limit is not None and used is not None and used <= limit:
        remaining = limit - used
    if remaining is None or limit is None or limit <= 0:
        return None

    reset_at = raw.get("resetAt")
    if not isinstance(reset_at, str):
        reset_at = iso_from_epoch(raw.get("reset_at"))

    label = raw.get("label", default_label)
    if not isinstance(label, str) or not label.strip():
        label = default_label

    # The applet renders a percent window as "12%" and a counted one as
    # "12 / 300", so the distinction is carried in the payload instead of
    # being guessed from a limit that happens to equal 100.
    unit = raw.get("unit")
    if unit not in {"percent", "count"}:
        unit = "percent" if percentage is not None or limit == 100 else "count"

    return {
        "id": str(raw.get("id", default_id)),
        "label": label,
        "remaining": remaining,
        "limit": limit,
        "used": used,
        "usedPercentage": percentage,
        "unit": unit,
        "resetAt": reset_at,
    }


def normalize(raw: Any, spec: dict[str, Any]) -> dict[str, Any]:
    """Normalize one source without inventing a quota value."""
    if not isinstance(raw, dict):
        raw = {"state": "error", "detail": "Usage source did not return a JSON object"}

    windows: list[dict[str, Any]] = []
    raw_windows = raw.get("windows")
    if isinstance(raw_windows, list):
        for index, candidate in enumerate(raw_windows):
            window = normalize_window(candidate, f"window-{index}", "Window")
            if window:
                windows.append(window)

    primary = windows[0] if windows else normalize_window(raw, "primary", "Remaining")
    if primary and not windows:
        windows.append(primary)

    if primary:
        state = raw.get("state", "ok")
        if state not in {"ok", "stale", "rateLimited"}:
            state = "ok"
    else:
        state = raw.get("state", "unknown")
        if state not in {
            "unknown",
            "unsupported",
            "unauthenticated",
            "forbidden",
            "error",
            "stale",
            "rateLimited",
        }:
            state = "unknown"

    detail = raw.get("detail")
    if not isinstance(detail, str) or not detail.strip():
        detail = spec["defaultDetail"] if state in {"unknown", "unsupported", "unauthenticated"} else ""

    fetched_at = raw.get("fetchedAt")
    if not isinstance(fetched_at, str):
        fetched_at = datetime.now(timezone.utc).isoformat()

    source_url = raw.get("sourceUrl", spec["url"])
    if not isinstance(source_url, str) or not source_url.startswith(("https://", "http://")):
        source_url = spec["url"]

    return {
        "id": spec["id"],
        "name": spec["name"],
        "shortName": spec["shortName"],
        "symbol": spec["symbol"],
        "url": source_url,
        "state": state,
        "remaining": primary["remaining"] if primary else None,
        "limit": primary["limit"] if primary else None,
        "used": primary["used"] if primary else None,
        "usedPercentage": primary["usedPercentage"] if primary else None,
        "unit": primary["unit"] if primary else None,
        "resetAt": primary["resetAt"] if primary else None,
        "windows": windows,
        "detail": detail,
        "fetchedAt": fetched_at,
    }


def run_source(command: Any) -> tuple[Any | None, str | None]:
    if not isinstance(command, list) or not command or not all(
        isinstance(part, str) and part for part in command
    ):
        return None, "Provider command must be a non-empty JSON array"

    try:
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=COMMAND_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, "Provider command timed out or could not be started"

    if completed.returncode != 0:
        return None, "Provider command failed"

    try:
        return json.loads(completed.stdout), None
    except (ValueError, TypeError):
        return None, "Provider command returned invalid JSON"


def http_json(url: str, headers: dict[str, str], method: str = "GET", data: bytes | None = None) -> tuple[Any | None, dict[str, str], int, str | None]:
    request = Request(url, headers=headers, method=method, data=data)
    try:
        with urlopen(request, timeout=COMMAND_TIMEOUT_SECONDS) as response:
            body = response.read()
            try:
                return json.loads(body), dict(response.headers.items()), response.status, None
            except (ValueError, TypeError):
                return None, dict(response.headers.items()), response.status, "Invalid JSON response"
    except HTTPError as error:
        try:
            body = error.read()
            parsed = json.loads(body) if body else None
        except (OSError, ValueError, TypeError):
            parsed = None
        return parsed, dict(error.headers.items()) if error.headers else {}, error.code, None
    except (OSError, URLError, TimeoutError):
        return None, {}, 0, "Network request failed"


def http_text(url: str, headers: dict[str, str]) -> tuple[str | None, int, str | None]:
    """Fetch a URL as text, for endpoints that answer HTML rather than JSON."""
    request = Request(url, headers=headers, method="GET")
    try:
        with urlopen(request, timeout=COMMAND_TIMEOUT_SECONDS) as response:
            return response.read().decode("utf-8", errors="replace"), response.status, None
    except HTTPError as error:
        return None, error.code, None
    except (OSError, URLError, TimeoutError):
        return None, 0, "Network request failed"


def codex_auth_path() -> Path:
    return Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "auth.json"


def write_json_in_place(path: Path, payload: Any) -> None:
    """Rewrite an existing file without replacing its inode.

    ~/.codex/auth.json is a hardlink to CLIProxyAPI's copy, and a write through a
    temporary file and rename would leave CLIProxyAPI holding the old token. The
    existing file's mode is kept, so a file narrowed to 0600 stays that way.
    """
    data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    with os.fdopen(os.open(path, os.O_WRONLY), "wb") as stream:
        stream.write(data)
        stream.truncate(len(data))


def codex_tokens(auth: dict[str, Any]) -> dict[str, Any] | None:
    """The token record in either layout: Codex CLI nests it under "tokens",
    CLIProxyAPI keeps it at the top level of the same file."""
    nested = auth.get("tokens")
    if isinstance(nested, dict):
        return nested
    if isinstance(auth.get("access_token"), str):
        return auth
    return None


def refresh_codex_token(auth: dict[str, Any], refresh_token: str) -> str | None:
    body = urlencode({
        "grant_type": "refresh_token",
        "client_id": CODEX_CLIENT_ID,
        "refresh_token": refresh_token,
    }).encode("utf-8")
    payload, _, status, _ = http_json(
        CODEX_REFRESH_URL,
        {"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"},
        method="POST",
        data=body,
    )
    if not 200 <= status < 300 or not isinstance(payload, dict):
        return None
    access_token = payload.get("access_token")
    if not isinstance(access_token, str) or not access_token:
        return None

    tokens = codex_tokens(auth)
    if tokens is None:
        return None
    tokens["access_token"] = access_token
    for key in ("refresh_token", "id_token"):
        if isinstance(payload.get(key), str) and payload[key]:
            tokens[key] = payload[key]
    try:
        write_json_in_place(codex_auth_path(), auth)
    except OSError:
        pass
    return access_token


def codex_window(raw: Any, slot: str, default_label: str, headers: dict[str, str]) -> dict[str, Any] | None:
    if not isinstance(raw, dict):
        raw = {}
    item = dict(raw)
    if used_percentage(item) is None:
        header_name = "x-codex-primary-used-percent" if slot == "primary" else "x-codex-secondary-used-percent"
        try:
            header_value = headers.get(header_name)
            if header_value is not None:
                item["used_percent"] = float(header_value)
        except (TypeError, ValueError):
            pass

    duration = finite_number(item.get("limit_window_seconds"))
    if duration is not None:
        if duration <= 24 * 60 * 60:
            item.setdefault("label", "5h")
        else:
            item.setdefault("label", "7d")
    item.setdefault("label", default_label)
    item.setdefault("id", slot)
    return normalize_window(item, slot, default_label)


def codex_source() -> dict[str, Any]:
    auth_path = codex_auth_path()
    auth = load_json(auth_path)
    if not isinstance(auth, dict):
        return {"state": "unauthenticated", "detail": "Codex login not found"}
    tokens = codex_tokens(auth)
    if tokens is None or not isinstance(tokens.get("access_token"), str):
        return {"state": "unauthenticated", "detail": "Sign in to Codex CLI with ChatGPT"}

    access_token = tokens["access_token"]
    account_id = tokens.get("account_id") if isinstance(tokens.get("account_id"), str) else ""
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Accept": "application/json",
        "User-Agent": USER_AGENT,
    }
    if account_id:
        headers["ChatGPT-Account-Id"] = account_id

    payload, response_headers, status, error = http_json(CODEX_USAGE_URL, headers)
    if status in {401, 403} and isinstance(tokens.get("refresh_token"), str):
        refreshed = refresh_codex_token(auth, tokens["refresh_token"])
        if refreshed:
            headers["Authorization"] = f"Bearer {refreshed}"
            payload, response_headers, status, error = http_json(CODEX_USAGE_URL, headers)

    if error:
        return {"state": "error", "detail": "Codex usage request failed"}
    if status == 429:
        return {"state": "rateLimited", "detail": "Codex usage endpoint is rate-limited"}
    if status in {401, 403}:
        return {"state": "unauthenticated", "detail": "Codex login expired; sign in again"}
    if not 200 <= status < 300 or not isinstance(payload, dict):
        return {"state": "error", "detail": f"Codex usage request failed ({status})"}

    rate_limit = payload.get("rate_limit")
    if not isinstance(rate_limit, dict):
        return {"state": "unknown", "detail": "Codex returned no rate-limit windows"}

    windows: list[dict[str, Any]] = []
    for slot, fallback_label in (("primary_window", "5h"), ("secondary_window", "7d")):
        window = codex_window(rate_limit.get(slot), slot, fallback_label.removesuffix("_window"), response_headers)
        if window:
            windows.append(window)

    # Codex can expose model-specific Spark windows alongside the normal pair.
    additional = payload.get("additional_rate_limits")
    if isinstance(additional, list):
        for entry in additional:
            if not isinstance(entry, dict):
                continue
            name = str(entry.get("limit_name", entry.get("metered_feature", "")))
            if "spark" not in name.lower() or not isinstance(entry.get("rate_limit"), dict):
                continue
            spark = entry["rate_limit"]
            for slot, fallback_label in (("primary_window", "Spark 5h"), ("secondary_window", "Spark 7d")):
                # codex_window labels a window from its duration, which would
                # name this one "7d" — the same as the combined weekly window,
                # leaving the popup with two rows a user cannot tell apart.
                # Set the Spark label first so that setdefault keeps it.
                raw_window = spark.get(slot)
                if isinstance(raw_window, dict):
                    raw_window = dict(raw_window)
                    raw_window.setdefault("label", fallback_label)
                window = codex_window(raw_window, slot, fallback_label, {})
                if window:
                    window["id"] = "spark-" + window["id"]
                    windows.append(window)

    detail = payload.get("plan_type")
    if not isinstance(detail, str) or not detail:
        detail = "Codex rate limits"
    credits = payload.get("rate_limit_reset_credits")
    if isinstance(credits, dict) and finite_number(credits.get("available_count")) is not None:
        detail = f"{detail} · {int(credits['available_count'])} reset credits"
    return {"state": "ok", "windows": windows, "detail": detail}


def copilot_source() -> dict[str, Any]:
    if not shutil_which("gh"):
        return {"state": "unauthenticated", "detail": "GitHub CLI (gh) is not installed"}
    try:
        completed = subprocess.run(
            ["gh", "api", "copilot_internal/user"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=COMMAND_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {"state": "error", "detail": "GitHub usage request timed out"}
    if completed.returncode != 0:
        return {"state": "unauthenticated", "detail": "Run gh auth login to read Copilot usage"}
    try:
        payload = json.loads(completed.stdout)
    except (ValueError, TypeError):
        return {"state": "error", "detail": "GitHub returned invalid Copilot usage data"}

    snapshots = payload.get("quota_snapshots") if isinstance(payload, dict) else None
    quota = snapshots.get("premium_interactions") if isinstance(snapshots, dict) else None
    if not isinstance(quota, dict):
        return {"state": "unknown", "detail": "GitHub returned no premium-request quota"}
    if quota.get("unlimited") is True:
        return {"state": "ok", "detail": "Premium interactions unlimited"}

    remaining = finite_number(quota.get("remaining"))
    limit = finite_number(quota.get("entitlement"))
    if remaining is None or limit is None or limit <= 0:
        return {"state": "unknown", "detail": "GitHub returned no finite premium-request quota"}
    reset_at = payload.get("quota_reset_date_utc") or payload.get("quota_reset_date")
    return {
        "state": "ok",
        "windows": [{
            "id": "premium-interactions",
            "label": "Premium",
            "unit": "count",
            "remaining": remaining,
            "limit": limit,
            "resetAt": reset_at,
        }],
        "detail": "Premium interactions",
    }


def mistral_timestamp(value: Any) -> str | None:
    """Vendor timestamps arrive as ISO strings (sometimes over-precise) or epochs."""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return iso_from_epoch(value)
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip().replace("Z", "+00:00")
    # fromisoformat accepts at most microseconds; vendors send more digits.
    text = re.sub(r"(\.\d{6})\d+", r"\1", text)
    try:
        return datetime.fromisoformat(text).isoformat()
    except ValueError:
        return value


def mistral_cookie() -> str | None:
    """The Admin-console session cookie, pasted into providers.json.

    Mistral's plan allowances are only exposed to a browser session, and
    browser cookie import is unavailable on Linux, so the user pastes the
    Cookie header from admin.mistral.ai into
    {"providers": {"mistral": {"cookie": "..."}}} — the same manual mode
    CodexBar uses. Keep the file 0600: it holds a session credential.
    """
    record = provider_records(load_json(config_dir() / "providers.json")).get("mistral")
    if not isinstance(record, dict):
        return None
    cookie = record.get("cookie")
    if not isinstance(cookie, str):
        return None
    cookie = cookie.strip()
    if cookie[:7].lower() == "cookie:":
        cookie = cookie[7:].strip()
    if not cookie or "\r" in cookie or "\n" in cookie:
        return None
    return cookie


def cookie_pairs(cookie_header: str) -> dict[str, str]:
    pairs: dict[str, str] = {}
    for part in cookie_header.split(";"):
        name, separator, value = part.partition("=")
        name = name.strip()
        if separator and name:
            pairs[name] = value.strip()
    return pairs


def flight_json_container_end(data: bytes, start: int) -> int | None:
    """The end of the JSON array starting at `start`, string-aware."""
    closers: list[int] = []
    in_string = False
    escaped = False
    index = start
    while index < len(data):
        byte = data[index]
        if in_string:
            if escaped:
                escaped = False
            elif byte == 0x5C:
                escaped = True
            elif byte == 0x22:
                in_string = False
        elif byte == 0x22:
            in_string = True
        elif byte in (0x5B, 0x7B):
            closers.append(0x5D if byte == 0x5B else 0x7D)
        elif byte in (0x5D, 0x7D):
            if not closers or closers[-1] != byte:
                return None
            closers.pop()
            if not closers:
                return index + 1
        index += 1
    return None


def flight_chunks(html: bytes) -> list[str]:
    """The string payloads of the page's self.__next_f.push([1, "..."]) calls."""
    chunks: list[str] = []
    cursor = 0
    while True:
        marker = html.find(FLIGHT_PUSH_MARKER, cursor)
        if marker == -1:
            return chunks
        start = marker + len(FLIGHT_PUSH_MARKER)
        while start < len(html) and html[start] in b" \t\r\n":
            start += 1
        end = None
        if start < len(html) and html[start:start + 1] == b"[":
            end = flight_json_container_end(html, start)
        if end is not None:
            try:
                array = json.loads(html[start:end])
            except ValueError:
                array = None
            if (
                isinstance(array, list)
                and len(array) >= 2
                and not isinstance(array[0], bool)
                and array[0] == 1
                and isinstance(array[1], str)
            ):
                chunks.append(array[1])
            cursor = end
        else:
            cursor = marker + len(FLIGHT_PUSH_MARKER)


def flight_models(stream: bytes) -> list[Any] | None:
    """The JSON rows of a Flight stream, or None when a row is malformed.

    Rows look like "<hex>:<payload>". A payload starting with "[" or "{" is
    JSON; one starting with a text tag carries a byte-counted payload that is
    skipped whole, because it can contain fake rows and newlines.
    """
    models: list[Any] = []
    cursor = 0
    while cursor < len(stream):
        line_end = stream.find(b"\n", cursor)
        if line_end == -1:
            line_end = len(stream)
        line = stream[cursor:line_end]
        colon = line.find(b":")
        if colon <= 0 or not all(_is_hex_digit(byte) for byte in line[:colon]):
            cursor = line_end + 1 if line_end < len(stream) else line_end
            continue
        payload_start = cursor + colon + 1
        tag = stream[payload_start:payload_start + 1]
        if tag in (b"[", b"{"):
            try:
                models.append(json.loads(stream[payload_start:line_end]))
            except ValueError:
                return None
            cursor = line_end + 1 if line_end < len(stream) else line_end
            continue
        if tag and tag[0] in FLIGHT_TEXT_TAGS:
            comma = stream.find(b",", payload_start, line_end)
            length_bytes = stream[payload_start + 1:comma] if comma != -1 else b""
            if (
                comma == -1
                or not length_bytes
                or not all(_is_hex_digit(byte) for byte in length_bytes)
            ):
                return None
            length = int(length_bytes, 16)
            payload = comma + 1
            if length > len(stream) - payload:
                return None
            cursor = payload + length
            continue
        cursor = line_end + 1 if line_end < len(stream) else line_end
    return models


def _is_hex_digit(byte: int) -> bool:
    return 48 <= byte <= 57 or 65 <= byte <= 70 or 97 <= byte <= 102


def mistral_budget_record(raw: Any) -> dict[str, Any] | None:
    """One api_budget / vibe_budget record, validated, with derived amounts."""
    if not isinstance(raw, dict):
        return None
    percentage = finite_number(raw.get("usage_percentage"))
    limit = finite_number(raw.get("initial_budget"))
    currency = raw.get("currency")
    if (
        percentage is None or not math.isfinite(percentage) or percentage < 0
        or limit is None or not math.isfinite(limit) or limit <= 0
        or not isinstance(currency, str) or not currency.strip()
    ):
        return None
    used = limit * percentage / 100
    if not math.isfinite(used):
        return None
    return {
        "usedPercentage": percentage,
        "limit": limit,
        "used": used,
        "remaining": max(0, limit - used),
        "currency": currency.strip().upper(),
        "resetAt": mistral_timestamp(raw.get("reset_at")),
    }


def budget_record_key(budget: dict[str, Any] | None) -> tuple[Any, ...] | None:
    if budget is None:
        return None
    return (budget["usedPercentage"], budget["limit"], budget["currency"], budget["resetAt"])


def collect_budget_records(value: Any, found: dict[tuple[Any, ...], tuple[Any, Any]]) -> None:
    if isinstance(value, dict):
        budget = value.get("budget")
        if isinstance(budget, dict):
            api = mistral_budget_record(budget.get("api_budget"))
            vibe = mistral_budget_record(budget.get("vibe_budget"))
            if api is not None or vibe is not None:
                key = (budget_record_key(api), budget_record_key(vibe))
                found[key] = (api, vibe)
        for child in value.values():
            collect_budget_records(child, found)
    elif isinstance(value, list):
        for child in value:
            collect_budget_records(child, found)


def parse_subscription_budgets(html: str) -> dict[str, Any] | None:
    """Extract the api_budget / vibe_budget pair from the subscription page.

    The page ships its data as React Flight chunks; exactly one distinct
    budget record must survive, matching CodexBar's parser, so a partial or
    contradictory page reads as no data rather than a wrong number.
    """
    stream = "".join(flight_chunks(html.encode("utf-8"))).encode("utf-8")
    models = flight_models(stream)
    if models is None:
        return None
    found: dict[tuple[Any, ...], tuple[Any, Any]] = {}
    for model in models:
        collect_budget_records(model, found)
    if len(found) != 1:
        return None
    api, vibe = next(iter(found.values()))
    return {"api": api, "vibe": vibe}


def mistral_vibe_usage_fallback(pairs: dict[str, str]) -> dict[str, Any] | None:
    """The console's billing.vibeUsage route, forwarded only what it needs.

    Only the csrftoken and ory_session_* cookies cross to console.mistral.ai;
    every other admin.mistral.ai cookie stays origin-bound, as in CodexBar.
    """
    csrf = pairs.get("csrftoken", "").strip()
    if not csrf or any(character in csrf for character in ";,\r\n"):
        return None
    console_cookie = "; ".join(
        ["csrftoken=" + csrf]
        + [f"{name}={pairs[name]}" for name in pairs if name.startswith("ory_session_")]
    )
    payload, _, status, error = http_json(MISTRAL_VIBE_USAGE_URL, {
        "Accept": "*/*",
        "Cookie": console_cookie,
        "X-CSRFToken": csrf,
        "User-Agent": USER_AGENT,
    })
    if error or status != 200 or not isinstance(payload, list) or not payload:
        return None
    first = payload[0]
    result = first.get("result") if isinstance(first, dict) else None
    data = result.get("data") if isinstance(result, dict) else None
    inner = data.get("json") if isinstance(data, dict) else None
    if not isinstance(inner, dict):
        return None
    percentage = finite_number(inner.get("usage_percentage"))
    if percentage is None or not math.isfinite(percentage) or not 0 <= percentage <= 100:
        return None
    return {
        "id": "vibe",
        "label": "Vibe Code",
        "unit": "percent",
        "usedPercentage": percentage,
        "resetAt": mistral_timestamp(inner.get("reset_at")),
    }


def mistral_console_windows(cookie: str) -> dict[str, Any]:
    """The plan's monthly allowances, read with a browser session.

    The Admin subscription page carries both allowances a plan includes —
    the API allowance and the Vibe Code allowance — as an api_budget /
    vibe_budget pair. The console's billing.vibeUsage route answers a Vibe
    percentage only and stands in when the page carries no Vibe budget.

    Returns {"windows": [...], "note": ... | None, "state": ...}. The note
    explains a configured-but-failing session; the state only matters when no
    window was produced.
    """
    pairs = cookie_pairs(cookie)
    if not any(name.startswith("ory_session_") for name in pairs):
        return {"windows": [], "note": "Mistral needs an ory_session cookie", "state": "error"}
    html, status, error = http_text(MISTRAL_SUBSCRIPTION_PAGE_URL, {
        "Accept": "text/html",
        "Accept-Language": "en-US,en;q=0.9",
        "Cookie": cookie,
        "Referer": MISTRAL_SUBSCRIPTION_PAGE_URL,
        "User-Agent": USER_AGENT,
    })
    if error:
        return {"windows": [], "note": "Mistral plan request failed", "state": "error"}
    if status in {401, 403}:
        return {"windows": [], "note": "Mistral session expired; paste a fresh cookie", "state": "unauthenticated"}
    if status != 200 or html is None:
        return {"windows": [], "note": "Mistral plan unavailable", "state": "error"}

    windows: list[dict[str, Any]] = []
    budgets = parse_subscription_budgets(html)
    api = budgets.get("api") if budgets else None
    if api is not None:
        windows.append({
            "id": "api",
            "label": "API",
            "unit": "count",
            "remaining": api["remaining"],
            "limit": api["limit"],
            "used": api["used"],
            "resetAt": api["resetAt"],
        })
    vibe = budgets.get("vibe") if budgets else None
    if vibe is None:
        # The console route answers a percentage only, where the page's
        # vibe_budget carries the EUR allowance.
        vibe = mistral_vibe_usage_fallback(pairs)
    else:
        vibe = {
            "id": "vibe",
            "label": "Vibe Code",
            "unit": "count",
            "remaining": vibe["remaining"],
            "limit": vibe["limit"],
            "used": vibe["used"],
            "resetAt": vibe["resetAt"],
        }
    if vibe is not None:
        windows.append(vibe)
    if not windows:
        # A plan without an allowance is a legitimate absence, not an error.
        return {"windows": [], "note": None, "state": "ok"}
    return {"windows": windows, "note": None, "state": "ok"}


def mistral_source() -> dict[str, Any]:
    """The plan's monthly allowances, read through a browser session.

    Mistral exposes the allowances a plan includes only to an Admin-console
    browser session; there is no API-key billing route, so the opt-in cookie
    is the credential.
    """
    cookie = mistral_cookie()
    if not cookie:
        return {"state": "unauthenticated",
                "detail": "Add a Mistral cookie in providers.json to read usage"}
    console = mistral_console_windows(cookie)
    if console["windows"]:
        return {"state": "ok", "windows": console["windows"], "detail": "Mistral subscription"}
    if console["note"]:
        return {"state": console["state"], "detail": console["note"]}
    return {"state": "unknown", "detail": "Mistral returned no allowance"}


def shutil_which(command: str) -> str | None:
    for directory in os.environ.get("PATH", os.defpath).split(os.pathsep):
        candidate = Path(directory) / command
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def claude_credentials_path() -> Path:
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    return (Path(base) if base else Path.home() / ".claude") / ".credentials.json"


def claude_oauth_record(record: Any) -> dict[str, Any] | None:
    if not isinstance(record, dict):
        return None
    oauth = record.get("claudeAiOauth")
    return oauth if isinstance(oauth, dict) else None


def claude_token_expired(oauth: dict[str, Any]) -> bool:
    # Refresh a minute early so a slow request cannot land after expiry.
    expires_at = finite_number(oauth.get("expiresAt"))
    if expires_at is None:
        return False
    return expires_at - 60_000 <= time.time() * 1000


def store_claude_tokens(
    path: Path, record: dict[str, Any], oauth: dict[str, Any], payload: dict[str, Any]
) -> None:
    """Persist a rotated login exactly where Claude Code expects to find it."""
    now_ms = int(time.time() * 1000)
    updated = dict(oauth)
    updated["accessToken"] = payload["access_token"]
    expires_in = finite_number(payload.get("expires_in"))
    if expires_in is not None:
        updated["expiresAt"] = now_ms + int(expires_in) * 1000
    refresh_expires_in = finite_number(payload.get("refresh_token_expires_in"))
    if refresh_expires_in is not None:
        updated["refreshTokenExpiresAt"] = now_ms + int(refresh_expires_in) * 1000
    rotated = payload.get("refresh_token")
    if isinstance(rotated, str) and rotated:
        updated["refreshToken"] = rotated
    scope = payload.get("scope")
    if isinstance(scope, str) and scope:
        updated["scopes"] = scope.split()
    merged = dict(record)
    merged["claudeAiOauth"] = updated
    write_json_atomic(path, merged)


def claude_access_token(stale_token: str | None = None) -> tuple[str | None, str]:
    """Return a usable Claude token, refreshing the stored login when needed."""
    injected = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if injected:
        return injected, ""

    path = claude_credentials_path()
    oauth = claude_oauth_record(load_json(path))
    if oauth is None:
        return None, "Sign in with Claude Code to read usage"
    token = oauth.get("accessToken")
    if (
        stale_token is None
        and isinstance(token, str)
        and token
        and not claude_token_expired(oauth)
    ):
        return token, ""

    # Anthropic rotates the refresh token on every exchange, so this
    # read-modify-write is serialized: dropping a rotation would sign the user
    # out of Claude Code itself.
    lock_path = path.with_name(path.name + ".limit-widget.lock")
    try:
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        with lock_path.open("a+", encoding="utf-8") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            record = load_json(path)
            oauth = claude_oauth_record(record)
            if oauth is None:
                return None, "Sign in with Claude Code to read usage"
            # Claude Code may have refreshed while this process waited.
            token = oauth.get("accessToken")
            if (
                isinstance(token, str)
                and token
                and token != stale_token
                and not claude_token_expired(oauth)
            ):
                return token, ""

            refresh_token = oauth.get("refreshToken")
            if not isinstance(refresh_token, str) or not refresh_token:
                return None, "Claude Code login expired; run claude to sign in again"
            scopes = [item for item in oauth.get("scopes", []) if isinstance(item, str)]
            body = json.dumps({
                "grant_type": "refresh_token",
                "refresh_token": refresh_token,
                "client_id": CLAUDE_CLIENT_ID,
                "scope": " ".join(scopes) or CLAUDE_DEFAULT_SCOPE,
            }).encode("utf-8")
            payload, _, status, _ = http_json(
                CLAUDE_TOKEN_URL,
                {
                    "Content-Type": "application/json",
                    "Accept": "application/json",
                    "User-Agent": USER_AGENT,
                },
                method="POST",
                data=body,
            )
            if (
                not 200 <= status < 300
                or not isinstance(payload, dict)
                or not isinstance(payload.get("access_token"), str)
            ):
                return None, "Claude Code login expired; run claude to sign in again"
            try:
                store_claude_tokens(path, record if isinstance(record, dict) else {}, oauth, payload)
            except OSError:
                # A readable token is still worth reporting; the next run retries.
                pass
            return payload["access_token"], ""
    except OSError:
        return None, "Could not read the Claude Code login"


def claude_window(raw: Any, key: str, label: str) -> dict[str, Any] | None:
    if not isinstance(raw, dict):
        return None
    reset_at = raw.get("resets_at")
    return normalize_window({
        "id": key,
        "label": label,
        "unit": "percent",
        "used_percentage": raw.get("utilization"),
        "resetAt": reset_at if isinstance(reset_at, str) else None,
    }, key, label)


def claude_usage_request(token: str) -> tuple[Any | None, int, str | None]:
    payload, _, status, error = http_json(CLAUDE_USAGE_URL, {
        "Authorization": f"Bearer {token}",
        "Accept": "application/json",
        "anthropic-beta": CLAUDE_OAUTH_BETA,
        "User-Agent": USER_AGENT,
    })
    return payload, status, error


def claude_source() -> dict[str, Any]:
    """Read the same usage endpoint Claude Code's own /usage command reads."""
    oauth = claude_oauth_record(load_json(claude_credentials_path())) or {}
    token, detail = claude_access_token()
    if token is None:
        return {"state": "unauthenticated", "detail": detail}

    payload, status, error = claude_usage_request(token)
    if status in {401, 403}:
        token, detail = claude_access_token(stale_token=token)
        if token is None:
            return {"state": "unauthenticated", "detail": detail}
        payload, status, error = claude_usage_request(token)

    if error:
        return {"state": "error", "detail": "Claude usage request failed"}
    if status == 429:
        return {"state": "rateLimited", "detail": "Claude usage endpoint is rate-limited"}
    if status in {401, 403}:
        return {"state": "unauthenticated", "detail": "Claude Code login expired; run claude to sign in again"}
    if not 200 <= status < 300 or not isinstance(payload, dict):
        return {"state": "error", "detail": f"Claude usage request failed ({status})"}

    windows = []
    for key, label in CLAUDE_WINDOWS:
        window = claude_window(payload.get(key), key, label)
        if window:
            windows.append(window)
    if not windows:
        return {"state": "unknown", "detail": "Claude returned no rate-limit windows"}

    plan = oauth.get("subscriptionType")
    detail = f"Claude {plan.capitalize()}" if isinstance(plan, str) and plan else "Claude subscription windows"
    return {"state": "ok", "windows": windows, "detail": detail}


def age_suffix(fetched_at: Any) -> str:
    if not isinstance(fetched_at, str):
        return ""
    try:
        moment = datetime.fromisoformat(fetched_at.replace("Z", "+00:00"))
    except ValueError:
        return ""
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=timezone.utc)
    seconds = (datetime.now(timezone.utc) - moment).total_seconds()
    if seconds < 90 * 60:
        return f" · {max(1, round(seconds / 60))} min old"
    if seconds < 36 * 60 * 60:
        return f" · {round(seconds / 3600)} h old"
    return f" · {round(seconds / 86400)} days old"


def claude_cache_source() -> dict[str, Any] | None:
    """Last values the status-line bridge saw, reported as explicitly stale.

    An elapsed window is not evidence that nothing was consumed since, so the
    cached numbers are never rewritten to zero; they are labelled with their age.
    """
    record = provider_records(load_json(config_dir() / "claude-limits.json")).get("claude")
    if not isinstance(record, dict) or not record.get("windows"):
        return None
    record = dict(record)
    record["state"] = "stale"
    record["detail"] = "Claude Code status-line cache" + age_suffix(record.get("fetchedAt"))
    return record


def auto_source(provider_id: str) -> dict[str, Any] | None:
    if os.environ.get("LIMIT_WIDGET_DISABLE_AUTO") == "1":
        return None
    if provider_id == "codex":
        return codex_source()
    if provider_id == "copilot":
        return copilot_source()
    if provider_id == "mistral":
        return mistral_source()
    # Claude's own /usage endpoint is authoritative and does not need Claude
    # Code to be running; the status-line cache is only a labelled fallback.
    if provider_id == "claude":
        live = claude_source()
        if live["state"] == "ok":
            return live
        return claude_cache_source() or live
    return None


# --- CodexBar interoperability ----------------------------------------------
#
# CodexBar (https://github.com/steipete/CodexBar, MIT) is a macOS menu-bar app
# that also ships a Linux CLI covering far more providers than this widget
# reads natively. When that CLI is on PATH, its providers are offered here too.
#
# It stays strictly optional. The native collectors need nothing
# installed, which is the whole point of shipping them inside the package, so
# they keep their own rows and CodexBar only contributes providers they do not
# already cover. A user who wants breadth installs the binary; a user who wants
# a widget that just works does nothing.

CODEXBAR_TIMEOUT_SECONDS = 20
# windowMinutes -> the label this widget uses for a window of that length.
CODEXBAR_WINDOW_LABELS = ((300, "5h"), (10080, "7d"), (43200, "30d"))


def codexbar_label(window_minutes: Any, fallback: str) -> str:
    minutes = finite_number(window_minutes)
    if minutes is None:
        return fallback
    for known, label in CODEXBAR_WINDOW_LABELS:
        if abs(minutes - known) < 1:
            return label
    if minutes < 60:
        return f"{int(minutes)}m"
    if minutes < 1440:
        return f"{int(minutes / 60)}h"
    return f"{int(minutes / 1440)}d"


def codexbar_window(raw: Any, window_id: str, fallback_label: str) -> dict[str, Any] | None:
    if not isinstance(raw, dict):
        return None
    return normalize_window({
        "id": window_id,
        "label": codexbar_label(raw.get("windowMinutes"), fallback_label),
        "unit": "percent",
        "used_percentage": raw.get("usedPercent"),
        "resetAt": raw.get("resetsAt") if isinstance(raw.get("resetsAt"), str) else None,
    }, window_id, fallback_label)


def codexbar_record(entry: Any) -> dict[str, Any] | None:
    """Turn one CodexBar provider entry into this widget's shape."""
    if not isinstance(entry, dict):
        return None
    usage = entry.get("usage")
    if not isinstance(usage, dict):
        return None

    windows: list[dict[str, Any]] = []
    for slot, fallback in (("primary", "Session"), ("secondary", "Weekly"), ("tertiary", "Monthly")):
        window = codexbar_window(usage.get(slot), slot, fallback)
        if window:
            windows.append(window)

    # Per-model and feature caps ride alongside the standard slots. They are
    # kept, and titled, so a tighter cap cannot hide behind a looser one.
    extra = usage.get("extraRateWindows")
    if isinstance(extra, list):
        for item in extra:
            if not isinstance(item, dict):
                continue
            title = item.get("title")
            window = codexbar_window(
                item.get("window"),
                str(item.get("id") or "extra"),
                title if isinstance(title, str) and title.strip() else "Window",
            )
            if window:
                if isinstance(title, str) and title.strip():
                    window["label"] = title.strip()
                windows.append(window)

    if not windows:
        return None

    detail_parts = []
    login = usage.get("loginMethod")
    if isinstance(login, str) and login:
        detail_parts.append(login.capitalize())
    credits = entry.get("credits")
    if isinstance(credits, dict):
        remaining = finite_number(credits.get("remaining"))
        if remaining is not None:
            detail_parts.append(f"{remaining:g} credits")
    return {
        "state": "ok",
        "windows": windows,
        "detail": " · ".join(detail_parts) or "via CodexBar",
    }


def codexbar_program(configured: Any = None) -> str | None:
    """Locate the CodexBar CLI: explicit path, environment, then PATH."""
    for candidate in (configured, os.environ.get("LIMIT_WIDGET_CODEXBAR")):
        if isinstance(candidate, str) and candidate.strip():
            path = Path(candidate.strip()).expanduser()
            if path.is_file() and os.access(path, os.X_OK):
                return str(path)
            return None
    return shutil_which("codexbar")


def codexbar_entries(program: str | None = None) -> list[dict[str, Any]]:
    """Run the CodexBar CLI once and return its provider entries."""
    program = program or codexbar_program()
    if not program:
        return []
    try:
        completed = subprocess.run(
            [program, "usage", "--format", "json", "--no-color"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=CODEXBAR_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if completed.returncode != 0:
        return []
    try:
        payload = json.loads(completed.stdout)
    except (ValueError, TypeError):
        return []
    if isinstance(payload, dict):
        payload = payload.get("providers", [payload])
    return [item for item in payload if isinstance(item, dict)] if isinstance(payload, list) else []


def codexbar_extra_providers(covered: set[str], program: str | None = None) -> list[dict[str, Any]]:
    """Rows for CodexBar providers this widget has no native collector for."""
    rows: list[dict[str, Any]] = []
    for entry in codexbar_entries(program):
        provider_id = entry.get("provider")
        if not isinstance(provider_id, str) or provider_id in covered:
            continue
        record = codexbar_record(entry)
        if record is None:
            continue
        name = provider_id.replace("-", " ").replace("_", " ").title()
        spec = {
            "id": f"codexbar:{provider_id}",
            "name": name,
            "shortName": name[:1].upper(),
            # No vendor artwork is bundled for these, so they use the neutral
            # glyph rather than a mark this project has no licence for.
            "symbol": "codex-generic-symbolic.svg",
            "url": "",
            "defaultDetail": "Reported by CodexBar",
        }
        rows.append(normalize(record, spec))
    return rows


def snapshot() -> dict[str, Any]:
    directory = config_dir()
    preferences = load_json(directory / "providers.json")
    configured = provider_records(preferences)
    saved = provider_records(load_json(directory / "limits.json"))

    output: list[dict[str, Any]] = []
    for spec in PROVIDERS:
        provider_id = spec["id"]
        raw: Any = None
        error: str | None = None
        configured_provider = configured.get(provider_id, {})

        if isinstance(configured_provider, dict) and "command" in configured_provider:
            raw, error = run_source(configured_provider["command"])
        else:
            error = None
            raw = auto_source(provider_id)
            if raw is None or (raw.get("state") == "unauthenticated" and provider_id in saved):
                # A saved snapshot is the credential-free source: it is read
                # only when no live sign-in exists, never to shadow one with
                # frozen values.
                raw = saved.get(provider_id)

        if error:
            raw = {"state": "error", "detail": error}
        elif raw is None:
            raw = {"state": "unsupported", "detail": spec["defaultDetail"]}

        normalized = normalize(raw, spec)
        if isinstance(configured_provider.get("url"), str):
            normalized["url"] = configured_provider["url"]
        output.append(normalized)

    # Opt out with {"codexbar": {"enabled": false}} in providers.json.
    codexbar_preference = configured.get("codexbar", {})
    if not (isinstance(codexbar_preference, dict) and codexbar_preference.get("enabled") is False):
        configured_path = codexbar_preference.get("path") if isinstance(codexbar_preference, dict) else None
        program = codexbar_program(configured_path)
        if program:
            output.extend(codexbar_extra_providers({spec["id"] for spec in PROVIDERS}, program))

    return {
        "version": VERSION,
        "fetchedAt": datetime.now(timezone.utc).isoformat(),
        "providers": output,
    }


def main() -> int:
    if "--json" not in sys.argv[1:]:
        print("Usage: limit-widget-helper --json", file=sys.stderr)
        return 2
    json.dump(snapshot(), sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
